package main

import (
	"log"

	swagger "github.com/arsmn/fiber-swagger/v2"
	_ "party/docs"
	imservice "party/pkg/service"
	iomlog "gitlab.com/ft25/iom/framework/logger"
	iomcore "gitlab.com/ft25/iom/framework/rabbitmq"
	iomservice "gitlab.com/ft25/iom/framework/service"

	"internal/config"
	"internal/controller"
	"internal/repository"
	"am/pkg/cassandra"
)

// @title IOM.TokenService API
// @version 1.0
// @description API Spec autogenerated swagger.
// @termsOfService http://swagger.io/terms/
// @contact.name API Support
// @contact.email it-iom-dev@truecorp.co.th
// @license.name Apache 2.0
// @license.url http://www.apache.org/licenses/LICENSE-2.0.html
// @host 127.0.0.1
// @BasePath /token-service
func main() {

	var ctx iomcore.Context
	ctx.Logger, _ = iomlog.New("am")
	ctx.RabbitMQClient = iomcore.New()

	// Initialize configurations
	cfg := config.New()

	// Initialize database connection
	db, err := cassandra.NewCassandraConnection(cfg.CassandraConfig)
	if err != nil {
		log.Fatalf("Failed to connect to Cassandra: %v", err)
	}
	defer db.Close()

	// Initialize repository
	tokenRepo := repository.NewTokenRepository(db)

	// Initialize service
	tokenService := controller.NewTokenService(tokenRepo)

	// Initiallize rest servoce
	imservice.NewRestServiceController(tokenService)

	// Load application secret
	secrets, err := tokenService.GetSecrets("am")
	if err != nil {
		// log.Fatalf("Failed to load secret service: %v", err)
	}
	ctx.GV.SetByMap(secrets)

	routeServices, err := iomservice.LoadService(ctx, "am.TokenService", []interface{}{imservice.RestService{}})
	if err != nil {
		// log.Fatalf("Failed to loadService service: %v", err)
	}

	srv := iomservice.NewRestService(
		iomservice.WithAuthen(&ctx),
		iomservice.WithHealthcheck(),
		iomservice.WithLogger(nil),
		iomservice.WithRoute(routeServices),
		iomservice.WithSwagger("/swagger/*", swagger.HandlerDefault),
	)

	srv.Start()

}
